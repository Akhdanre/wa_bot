// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  waId            String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  stats           Stat[]
  fishProfile     FishProfile?
  reminderProfile ReminderProfile?
}

model Group {
  id               Int      @id @default(autoincrement())
  groupId          String   @unique
  name             String?
  schedulerEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  stats            Stat[]
}

model Stat {
  id            Int      @id @default(autoincrement())
  userId        Int
  groupId       Int
  count         Int      @default(0)
  totalText     Int      @default(0)
  totalBadWord  Int      @default(0)
  totalSticker  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model FishProfile {
  id          Int             @id @default(autoincrement())
  userId      Int             @unique
  coins       Int             @default(0)
  rodLevel    Int             @default(1)
  rodHealth   Int             @default(10)
  totalCaught Int             @default(0)
  totalTrash  Int             @default(0)
  totalSold   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory FishInventory[]
}

model FishInventory {
  id        Int         @id @default(autoincrement())
  profileId Int
  fishKey   String
  quantity  Int         @default(0)
  tankQuantity Int      @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile FishProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, fishKey])
}

model ReminderProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  enabled       Boolean  @default(true)
  breakfastTime String   @default("08:00")
  lunchTime     String   @default("12:30")
  dinnerTime    String   @default("19:00")
  lastSentMeal  String?
  lastSentDate  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
